<!-- Inbound policy on the MCP server in API Management. Not run against a live instance. -->
<inbound>
    <base />
    <validate-jwt header-name="Authorization" require-scheme="Bearer"
                  failed-validation-httpcode="401"
                  failed-validation-error-message="Unauthorized. Access token is missing or invalid."
                  output-token-variable-name="jwt">
        <openid-config url="https://{{external-tenant-subdomain}}.ciamlogin.com/{{external-tenant-id}}/v2.0/.well-known/openid-configuration" />
        <audiences>
            <audience>{{orders-mcp-api-client-id}}</audience>
        </audiences>
        <issuers>
            <issuer>https://{{external-tenant-id}}.ciamlogin.com/{{external-tenant-id}}/v2.0</issuer>
        </issuers>
        <required-claims>
            <claim name="scp" match="any" separator=" ">
                <value>Orders.Read</value>
            </claim>
        </required-claims>
    </validate-jwt>
    <!-- Never trust a customer header from the caller; set it from the validated token. -->
    <set-header name="Contoso-Customer-Oid" exists-action="delete" />
    <set-header name="Contoso-Demo-Customer" exists-action="delete" />
    <set-header name="Contoso-Customer-Oid" exists-action="override">
        <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", ""))</value>
    </set-header>
</inbound>
