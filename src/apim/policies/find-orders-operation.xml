<policies>
    <inbound>
        <base />
        <!-- The agent calls /me/orders; the backend expects /customers/{customerId}/orders. -->
        <rewrite-uri template="@("/customers/" + context.Request.Headers.GetValueOrDefault("AIDevMe-Customer-Id", "unknown") + "/orders")"
                     copy-unmatched-params="true" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
