# Copy to .env/.env and fill in your own values. .env is excluded from Git.
# Load it in Bash with:  set -a; source .env/.env; set +a
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# Workforce tenant for the samples, never the production tenant
SAMPLES_TENANT_ID=<samples-tenant-id>
# External ID tenant for customer sign-in (Part 5)
EXTERNAL_TENANT_ID=<external-tenant-id>
# App registrations in the External ID tenant (Part 5)
ORDERS_MCP_API_APP_ID=<api-app-id>
ORDERS_MCP_CONNECTOR_APP_ID=<connector-app-id>
# Workforce app for the Order Management API
ORDER_API_CLIENT_ID=<order-api-app-id>
ORDER_API_BASE_URL=<https://your-order-api-fqdn>
# Demo customers in the External ID tenant (oid -> customer ID)
DEMO_CUSTOMER_CU3001_OID=<oid-of-cu-3001>
DEMO_CUSTOMER_CU3002_OID=<oid-of-cu-3002>
# Logic Apps MCP server key (Part 2, Agents > MCP servers > Generate key)
AIDEVME_MCP_KEY=<logic-apps-mcp-key>
# Logic Apps MCP server with OAuth (Part 2, docs/copilot-studio-custom-mcp/tasks/TASK-part-2-oauth-easy-auth.md)
LOGIC_MCP_SERVER_APP_ID=<logic-mcp-server-app-id>
LOGIC_MCP_SCOPE_ID=<user-impersonation-scope-id>
LOGIC_MCP_CLIENT_APP_ID=<logic-mcp-copilot-studio-client-app-id>
