{
  "inputs": [
    {
      "type": "promptString",
      "id": "aidevme-mcp-key",
      "description": "Logic Apps MCP API key",
      "password": true
    }
  ],
  "servers": {
    "aidevme-orders": {
      "type": "http",
      "url": "https://<copied-mcp-server-url>",
      "headers": {
        "X-API-KEY": "${input:aidevme-mcp-key}",
        "AIDevMe-Demo-Customer": "CU-3001"
      }
    }
  }
}
