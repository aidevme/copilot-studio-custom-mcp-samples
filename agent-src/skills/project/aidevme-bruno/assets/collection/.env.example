# Only needed for the drafts folder (requests tagged "auth").
# Bruno CLI: set these in your shell instead; it reads the shell first, then this collection's .env file.
# Bruno app: copy this file to .env (gitignored) in the same folder and fill in the values yourself.
# Use a WordPress application password, never your login password.
AIDEVME_WP_USER=
AIDEVME_WP_APP_PASSWORD=
