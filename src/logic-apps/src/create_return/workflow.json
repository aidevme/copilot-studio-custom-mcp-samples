{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "description": "Starts a return for one line of a delivered AIDevMe order and returns the return number (RMA). Confirm the item, quantity and reason with the customer before calling it.",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string",
                "description": "The order number, for example SO-10023. Use get_order_status first if the line number is unknown."
              },
              "lineNumber": {
                "type": "integer",
                "description": "The order line to return, numbered 1, 2, 3 as listed by get_order_status."
              },
              "quantity": {
                "type": "integer",
                "description": "How many items of that line to return. At least 1 and not more than ordered."
              },
              "reason": {
                "type": "string",
                "description": "Return reason: Damaged, WrongItem, NotAsDescribed or NoLongerNeeded."
              },
              "comment": {
                "type": "string",
                "default": "",
                "description": "Optional note from the customer, for example what is damaged. Leave it empty if there is none."
              }
            },
            "required": ["orderId", "lineNumber", "quantity", "reason"]
          }
        }
      }
    },
    "actions": {
      "Get_caller_customer_id": {
        "type": "Compose",
        "runAfter": {},
        "inputs": "@coalesce(triggerOutputs()?['headers']?['AIDevMe-Demo-Customer'], '')"
      },
      "Get_order": {
        "type": "Http",
        "runAfter": {
          "Get_caller_customer_id": ["Succeeded"]
        },
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('OrderApiBaseUrl')}/orders/@{encodeUriComponent(triggerBody()?['orderId'])}",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "@parameters('OrderApiAudience')"
          }
        }
      },
      "Respond_order_lookup_failed": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "Get_order": ["Failed", "TimedOut"]
        },
        "inputs": {
          "statusCode": 404,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "Order not found. Ask the customer to check the order number."
          }
        }
      },
      "Check_order_belongs_to_caller": {
        "type": "If",
        "runAfter": {
          "Get_order": ["Succeeded"]
        },
        "expression": {
          "and": [
            {
              "not": {
                "equals": ["@outputs('Get_caller_customer_id')", ""]
              }
            },
            {
              "equals": ["@body('Get_order')?['customerId']", "@outputs('Get_caller_customer_id')"]
            }
          ]
        },
        "actions": {
          "Create_return": {
            "type": "Http",
            "runAfter": {},
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('OrderApiBaseUrl')}/orders/@{encodeUriComponent(triggerBody()?['orderId'])}/returns",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "lineNumber": "@triggerBody()?['lineNumber']",
                "quantity": "@triggerBody()?['quantity']",
                "reason": "@triggerBody()?['reason']",
                "comment": "@coalesce(triggerBody()?['comment'], '')"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "@parameters('OrderApiAudience')"
              }
            }
          },
          "Respond_return_created": {
            "type": "Response",
            "kind": "Http",
            "runAfter": {
              "Create_return": ["Succeeded"]
            },
            "inputs": {
              "statusCode": 201,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "@body('Create_return')"
            }
          },
          "Respond_return_rejected": {
            "type": "Response",
            "kind": "Http",
            "runAfter": {
              "Create_return": ["Failed", "TimedOut"]
            },
            "inputs": {
              "statusCode": "@coalesce(outputs('Create_return')?['statusCode'], 502)",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "error": "The return was not created. Explain the reason to the customer and do not retry automatically.",
                "details": "@body('Create_return')"
              }
            }
          }
        },
        "else": {
          "actions": {
            "Respond_not_found": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": {
                "statusCode": 404,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "error": "Order not found. Ask the customer to check the order number."
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
