@mcpUrl = https://<copied-mcp-server-url>
@apiKey = {{$processEnv AIDEVME_MCP_KEY}}

### 1. Initialize
POST {{mcpUrl}}
Content-Type: application/json
Accept: application/json, text/event-stream
X-API-KEY: {{apiKey}}

{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "aidevme-test-client", "version": "1.0.0"}}}

### 2. Confirm initialization (send Mcp-Session-Id too if the server returned one)
POST {{mcpUrl}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-06-18
X-API-KEY: {{apiKey}}

{"jsonrpc": "2.0", "method": "notifications/initialized"}

### 3. Call create_return
POST {{mcpUrl}}
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-06-18
X-API-KEY: {{apiKey}}
AIDevMe-Demo-Customer: CU-3001

{"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "create_return", "arguments": {"orderId": "SO-10023", "lineNumber": 1, "quantity": 1, "reason": "Damaged", "comment": "The kettle arrived with a cracked lid."}}}
